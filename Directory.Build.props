<Project>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <!--<Version>2.0.1-beta0930-01</Version>-->
    <PackageProjectUrl>https://github.com/dn32/Fluent.Infrastructure.Doc</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dn32/Fluent.Infrastructure.Doc</RepositoryUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <SignAssembly>true</SignAssembly>
  </PropertyGroup>

  <Target Name="CopyPackage" AfterTargets="Pack">
     <Copy SourceFiles="$(OutputPath)$(PackageId).$(PackageVersion).nupkg" DestinationFolder="C:\Users\Marcelo\Google Drive\FOut" />
  </Target>
 
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <Version>2.0.1.3-beta$([System.DateTime]::UtcNow.ToString(MMdd))39</Version>
  </PropertyGroup>
  
</Project>