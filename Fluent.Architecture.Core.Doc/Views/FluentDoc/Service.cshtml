@using Fluent.Architecture.Core.Models
@using Fluent.Architecture.Extensions
@using Fluent.Architecture.Core.Doc.Controllers
@using Fluent.Architecture.Core.Extensions
@using Fluent.Architecture
@using Fluent.Architecture.Core.Attributes
@using System.Reflection;
@using Fluent.Architecture.Core.Enumerator

@using static Fluent.Architecture.FluentDocExtension

@model FluentJsonSchema

@{
    ViewData["Title"] = Model.FluentJsonForm.name;
    var actions = ViewBag.actions as List<FluentActionSchema> ?? throw new InvalidOperationException("actions is not  List<FluentActionSchema>");

    string GetTypeName(Type type, string name)
    {
        if (type.GetListTypeNonNull().IsFluentEntity())
        {
            return $"<a href=\"/FluentDoc/Model?name={type.GetListTypeNonNull().FullName}\">{type.GetFriendlyName(false)}</a>";
        }
        else
        {
            return $"{name}: {type.GetFriendlyName(false)}";
        }
    }
}
<script>
    function navegate(url) {
        window.location.href = url;
    }
</script>
<div class="one-service-container">
    <h4 class="general-title">@Model.FluentJsonForm?.name (@actions.Count) </h4>

    @{
        string Is(bool operation, string text)
        {
            return operation ? text : "";
        }

        <div class="actions-container">

            @foreach (var action in actions)
            {
                if (action == null) { continue; }
                //var parameters = action.Parameters?.Select(x => GetTypeName(x.Type, x.Name)).ToArray() ?? new string[] { };
                //var paramString = string.Join(", ", parameters);
                var actionName = action?.MethodName ?? "";

                <div class="action" onclick="navegate('/FluentDoc/Action?service=@Model.FluentJsonForm.Type.GetListTypeNonNull().Name&actionName=@actionName')">
                    <span class="method @action.Method.ToLower()">@action.Method</span>
                    <span class="name">@action.Name.G()</span>
                    <span class="description">@action.Description</span>
                    @if (@action.Method == "GET")
                    {
                        <span class="route"><a href="@(action.ApiBaseUrl + action.Route)">@action.Route</a></span>
                    }
                    else
                    {
                        <span class="route">@action.Route</span>
                    }

                    @*@if (!string.IsNullOrWhiteSpace(paramString))
                        {
                            <span class="parameters">@(("params").G()): @Html.Raw(paramString)</span>
                        }*@

                </div>
            }

        </div>

        <div class="properties-container">
            <span class="title">@Model.FluentJsonForm?.name @(("Properties").G())</span>
            <table class="properties">
                <thead>
                    <tr>
                        <th>@(("Property").G())</th>
                        <th>@(("Name").G())</th>
                        <th>@(("Type").G())</th>
                        <th>@(("Others").G())</th>
                    </tr>
                </thead>
                @foreach (var property in Model.Properties)
                {
                    if (property.form == Fluent.Architecture.Core.Enumerator.EnumForm.NONE) { continue; }
                    if (property.Property.GetCustomAttribute<FluentDocAttribute>()?.Display == Fluent.Architecture.Core.Enumerator.EnumFluentDisplay.Hidden) { continue; }

                    var range = (property.min == property.max ? property.min.ToString() : property.min + ", " + property.max);
                    range = range == "0" ? "" : $" ({range})";

                    <tr class="property">
                        <td class="name">@property.propName</td>
                        <td class="description">@property.name</td>
                        <td class="type">@Html.Raw(GetTypeName(property.Type, property.Type.Name))@range</td>
                        <td>
                            @Html.Raw(Is(property.IsEnum, "<span><img src='/FluentDoc/img/ok.png'/> " + "enum".G() + "</span>"))
                            @Html.Raw(Is(property.IsKey || property.IsFluentUniqueKeyKey, "<span><img src='/FluentDoc/img/ok.png'/> " + "key".G() + "</span>"))
                            @Html.Raw(Is(property.IsList, "<span><img src='/FluentDoc/img/ok.png'/> " + "list".G() + "</span>"))
                            @Html.Raw(Is(property.IsNullable, "<span><img src='/FluentDoc/img/ok.png'/> " + "nullable".G() + "</span>"))
                            @Html.Raw(Is(property.required, "<span><img src='/FluentDoc/img/ok.png'/> " + "required".G() + "</span>"))
                            @Html.Raw(Is(property.IsFk, "<span><img src='/FluentDoc/img/ok.png'/>  " + "fk".G() + " <a href=\"/FluentDoc/Service?name=" + property.FkDestinal?.Type?.Name + "\">" + property.FkDestinal?.name + "</a></span>"))
                        </td>
                    </tr>
                }
            </table>
            <div class="example-value-container">
                <span>@("Example value".G())</span>

                @{
                    var exampleValue = Model.FluentJsonForm?.Type?.GetExampleValue() ?? "";

                    var json = exampleValue.ToFluentJson(Newtonsoft.Json.Formatting.Indented);

                    <pre class="example-value">@json</pre>
                }
            </div>
        </div>
    }
</div>
