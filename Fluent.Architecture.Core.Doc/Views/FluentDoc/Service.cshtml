@using Fluent.Architecture.Core.Entities
@using Fluent.Architecture.Extensions
@using Fluent.Architecture.Core.Doc.Controllers
@using Fluent.Architecture.Core.Extensions
@using Fluent.Architecture

<link rel="stylesheet" href="/FluentDoc/lib/bootstrap.min.css" />
<link rel="stylesheet" href="/FluentDoc/css/site.css" />

@model FluentJsonSchema

@{
    ViewData["Title"] = Model.FluentJsonForm.name;
    var actions = ViewBag.actions as List<FluentActionSchema>;

    string GetTypeName(Type type, string name)
    {
        if (type.GetListTypeNonNull().IsFluentEntity())
        {
            return $"<a href=\"/FluentDoc/Service?name={type.GetListTypeNonNull().GetFriendlyName(false)}\">{type.GetFriendlyName(false)}</a>";
        }
        else
        {
            return $"{name}: {type.GetFriendlyName(false)}";
        }
    }
}

<div class="one-service-container">
    <h4 class="general-title">@Model.FluentJsonForm?.name</h4>

    @{
        string Is(bool operation, string text)
        {
            return operation ? text : "";
        }

        <div class="actions-container">

            @foreach (var action in actions)
            {
                if (action == null) { continue; }
                var parameters = action.Parameters?.Select(x => GetTypeName(x.Type, x.Name)).ToArray() ?? new string[] { };

                var paramString = string.Join(", ", parameters);

                <div class="action">
                    <span class="method @action.Method.ToLower()">@action.Method</span>
                    <span class="name">@action.Name</span>
                    <span class="description">@action.Description</span>
                    @if (@action.Method == "GET")
                    {
                        <span class="route"><a href="@(action.ApiBaseUrl + action.Route)" target="_blank">@action.Route</a></span>
                    }
                    else
                    {
                        <span class="route">@action.Route</span>
                    }

                    @if (!string.IsNullOrWhiteSpace(paramString))
                    {
                        <span class="parameters">params: @Html.Raw(paramString)</span>
                    }

                </div>
            }

        </div>

        <div class="properties-container">
            <span class="title">@Model.FluentJsonForm?.name Properties</span>
            <table class="properties">
                <thead>
                    <tr>
                        <th>Property</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Others</th>
                    </tr>
                </thead>
                @foreach (var property in Model.Properties)
                {
                    if (property.form == Fluent.Architecture.Core.Enumerator.EnumForm.NONE) { continue; }
                    // if (property.FluentAggregation != null) { continue; }
                    // property.key

                    var range = (property.min == property.max ? property.min.ToString() : property.min + ", " + property.max);

                    <tr class="property">
                        <td class="name">@property.propName</td>
                        <td class="description">@property.name</td>
                        <td class="type">@Html.Raw(GetTypeName(property.Type, property.Type.Name)) (@range)</td>
                        @*<span class="range">Range: @property.min,@property.min </span>*@
                        <td>
                            @Html.Raw(Is(property.IsEnum, "<span><img src='/FluentDoc/img/ok.png'/> enum</span>"))
                            @Html.Raw(Is(property.IsKey, "<span><img src='/FluentDoc/img/ok.png'/> key</span>"))
                            @Html.Raw(Is(property.IsList, "<span><img src='/FluentDoc/img/ok.png'/> list</span>"))
                            @Html.Raw(Is(property.IsNullable, "<span><img src='/FluentDoc/img/ok.png'/> nullable</span>"))
                            @Html.Raw(Is(property.required, "<span><img src='/FluentDoc/img/ok.png'/> required</span>"))
                            @Html.Raw(Is(property.IsFk, "<span><img src='/FluentDoc/img/ok.png'/> fk <a href=\"/FluentDoc/Service?name=" + property.FkDestinal?.Type?.Name + "\">" + property.FkDestinal?.name + "</a></span>"))
                        </td>
                        @*<span class="value">Default value: @property.value</span>*@
                        @*<span class="name">@property.desc</span>*@

                        @*
                            <span class="grid">grid: @property.grid</span>
                            <span class="form">form: @property.form</span>
                            <span class="lGrid">lGrid: @property.lGrid</span>
                            <span class="Enums">Enums: @property.Enums</span>
                            <span class="FluentAggregation">FluentAggregation: @property.FluentAggregation</span>
                            <span class="FluentComposition">FluentComposition: @property.FluentComposition</span>
                            <span class="reference">reference: @property.reference</span>
                            <span class="Row">Row: @property.Row</span>
                            <span class="tgroup">tgroup: @property.tgroup</span>
                        *@

                    </tr>
                }
            </table>
            <div class="example-value-container">
                <span>Example value</span>

                @{
                    var exampleValue = Model.FluentJsonForm?.Type?.GetExampleValue() ?? "";

                    var json = exampleValue.ToFluentJson(Newtonsoft.Json.Formatting.Indented);

                    <pre class="example-value">@json</pre>
                }
            </div>
        </div>
    }
</div>
