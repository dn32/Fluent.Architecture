<link rel="stylesheet" href="/FluentDoc/lib/bootstrap.min.css" />
<link rel = "stylesheet" href= "/FluentDoc/css/site.css" />
@{
    ViewData["Title"] = "Autentication";
}

<div class="services-container">
    <span class="general-title">Autentication</span>

    <form method="post">
        <div class="form-group">
            <label for="user">Username</label>
            <input class="form-control" placeholder="Enter a username" name="user" />
        </div>  
        <div class="form-group">
            <label for="user">Password</label>
            <input type="password" class="form-control" placeholder="Enter a username" name="psw" />
        </div>
        <button type="submit" class="btn btn-primary">Login</button>
    </form>

</div>
