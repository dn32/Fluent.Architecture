@using Fluent.Architecture.Core.Doc.Controllers
@using static Fluent.Architecture.FluentDocExtension

<link rel="stylesheet" href="/FluentDoc/lib/bootstrap.min.css" />
<link rel="stylesheet" href="/FluentDoc/css/site.css" />

@model List<EntityModelAndName>

@{
    var title = "Available entities";
    ViewData["Title"] = title.G();
}

<div class="services-container">
    <span class="general-title">@title.G() (@Model.Count)</span>

    @{
        foreach (var entity in Model)
        {
            <div class="service">
                <span class="title"><a href="/FluentDoc/Model?name=@entity.FullName">@entity.Name</a></span>
                <span class="description">@entity.FriendlyName</span>
            </div>
        }
    }
</div>
