@using Fluente.Arquitetura.Nucleo.Doc.Controllers
@using static Fluente.Arquitetura.FluenteDocExtension

@model List<EntityModelAndName>

@{
    var title = "Available entities";
    ViewData["Title"] = title.G();
}

<div class="services-container">
    <span class="general-title">@title.G() (@Model.Count)</span>

    @{
        foreach (var entity in Model)
        {
            <div class="service">
                <span class="title"><a href="/FluenteDoc/Model?name=@entity.FullName">@entity.Name</a></span>
                <span class="description">@entity.FriendlyName</span>
            </div>
        }
    }
</div>
