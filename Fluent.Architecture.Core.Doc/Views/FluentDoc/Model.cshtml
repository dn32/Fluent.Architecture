@using dn32.infra.Nucleo.Models
@using dn32.infra.Extensoes
@using dn32.infra
@using System.Reflection;
@using dn32.infra.atributos
@using dn32.infra.enumeradores
@using dn32.infra.Nucleo.Atributos
@using dn32.infra.Interfaces;

@using static dn32.infra.FluenteDocExtension

@model FluenteJsonSchema

@{
    ViewData["Title"] = Model.FluenteJsonForm.name;
}
<script>
    function navegate(url) {
        window.location.href = url;
    }
</script>
<div class="one-service-container">
    <h4 class="general-title">@Model.FluenteJsonForm.name</h4>

    @{
        string Is(bool operation, string text)
        {
            return operation ? text : "";
        }

        <div class="properties-container" style="display:@(Model.Properties.Any() ? "block" : "none")">
            <span class="title">@(("Properties").G())</span>
            <table class="properties">
                <thead>
                    <tr>
                        <th>@(("Property").G())</th>
                        <th>@(("Name").G())</th>
                        <th>@(("Description").G())</th>
                        <th>@(("Type").G())</th>
                        <th>@(("Others").G())</th>
                    </tr>
                </thead>
                @foreach (var property in Model.Properties)
                {
                    if (property.form == EnumTipoDeComponenteDeFormularioDeTela.Nenhum) { continue; }
                    if (property.Property?.GetCustomAttribute<FluenteDocAtributo>()?.Apresentacao == EnumMostrar.Ocultar) { continue; }

                    var range = (property.min == property.max ? property.min.ToString() : property.min + ", " + property.max);
                    range = range == "0" ? "" : $" ({range})";

                    <tr class="property">
                        <td class="name">@property.propName</td>
                        <td class="name">@property.name</td>
                        <td class="description">@property.desc</td>

                        @if (string.IsNullOrWhiteSpace(property.Link))
                        {
                            <td class="type">@Html.Raw(property.Type.GetFriendlyName())</td>
                        }
                        else
                        {
                            <td class="type"><a href="@property.Link">@Html.Raw(property.Type.GetFriendlyName())</a></td>
                        }
                        <td>
                            @Html.Raw(Is(property.IsEnum, "<span><img src='/FluenteDoc/img/ok.png'/> " + "enum".G() + "</span>"))
                            @Html.Raw(Is(property.IsKey || property.IsFluenteUniqueKeyKey, "<span><img src='/FluenteDoc/img/ok.png'/> " + "key".G() + "</span>"))
                            @Html.Raw(Is(property.IsList, "<span><img src='/FluenteDoc/img/ok.png'/> " + "list".G() + "</span>"))
                            @Html.Raw(Is(property.IsNullable, "<span><img src='/FluenteDoc/img/ok.png'/> " + "nullable".G() + "</span>"))
                            @Html.Raw(Is(property.required, "<span><img src='/FluenteDoc/img/ok.png'/> " + "required".G() + "</span>"))
                            @Html.Raw(Is(property.FluenteAggregation != null, "<span><img src='/FluenteDoc/img/ok.png'/> " + "navegation".G() + "</span>"))
                            @Html.Raw(Is(property.FluenteComposition != null, "<span><img src='/FluenteDoc/img/ok.png'/> " + "navegation".G() + "</span>"))
                            @Html.Raw(Is(property.IsFk, "<span><img src='/FluenteDoc/img/ok.png'/>  " + "fk".G() + " <a href=\"/FluenteDoc/Model?name=" + property.FkDestinal?.Type?.Name + "\">" + property.FkDestinal?.propName + "</a></span>"))
                        </td>
                    </tr>
                }
            </table>
            @{
                var exampleValue = Model.FluenteJsonForm?.Type?.GetExampleValueString() ?? "";

                if (!string.IsNullOrWhiteSpace(exampleValue) && exampleValue != "null")
                {
                    <div class="example-value-container">
                        <span>@("Example value".G())</span>
                        <pre class="example-value">@exampleValue</pre>
                    </div>
                }
            }
        </div>
    }
</div>
