@using Fluent.Architecture
@using static Fluent.Architecture.FluentDocExtension
@{
    var action = ViewContext.RouteData.Values["Action"].ToString().ToLower();
    var controller = ViewContext.RouteData.Values["Controller"].ToString().ToLower();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @(("Available services").G())</title>
    <link rel="stylesheet" href="/FluentDoc/lib/bootstrap.min.css" />
    <link rel="stylesheet" href="/FluentDoc/css/site.css" />
</head>
<body>

    <header>
        @await Html.PartialAsync("_fluent_custom_header")
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container principal-menu">

                <a class="navbar-brand @(controller == "fluentdoc" && (action == "service" || action == "index") ? "active" : "")" asp-area="" asp-controller="FluentDoc" asp-action="Index">@(("Services").G())</a> |

                <a class="navbar-brand @(controller == "fluentdoc" && action == "entity" ? "active" : "")" asp-area="" asp-controller="FluentDoc" asp-action="Entity">@(("Entity").G())</a> |

                <a class="navbar-brand @(controller == "fluentdoc" && (action == "model" || action == "modelnoentity") ? "active" : "")" asp-area="" asp-controller="FluentDoc" asp-action="ModelNoEntity">@(("Model").G())</a> |

                <a class="navbar-brand @(controller == "authentication" ? "active" : "")" asp-area="" asp-controller="FluentDoc" asp-action="Token">@(("Authentication").G())</a>

            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            <a href="https://github.com/dn32/Fluent.Infrastructure.Doc/wiki" target="_blank">Fluent Architecture Doc  &copy; - @(("Available services").G())</a>
        </div>
    </footer>

    <script src="/FluentDoc/lib/jquery-3.4.1.min.js"></script>
    <script src="/FluentDoc/lib/bootstrap.min.js"></script>

</body>
</html>
